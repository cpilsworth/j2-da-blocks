{
  "project": "J2 Retail",
  "host": "retail.diffatech.co.uk",
  "trustedHosts": [
    "retail.diffatech.co.uk",
    "trade.diffatech.co.uk"
  ],
  "plugins": [
    {
      "id": "live-domain-switcher",
      "title": "Live Site",
      "isContainer": true,
      "environments": [
        "prod"
      ]
    },
    {
      "containerId": "live-domain-switcher",
      "id": "open-retail-live",
      "title": "Retail",
      "event": "open-retail-live",
      "environments": [
        "prod"
      ]
    },
    {
      "containerId": "live-domain-switcher",
      "id": "open-trade-live",
      "title": "Trade",
      "event": "open-trade-live",
      "environments": [
        "prod"
      ]
    }
  ]
}
